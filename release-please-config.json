        },
        {
          "type": "toml",
          "path": "crates/core-clipboard/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "crates/core-discovery/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "crates/core-input/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "crates/core-protocol/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "crates/core-security/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
