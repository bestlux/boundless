{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "draft": true,
  "force-tag-creation": true,
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "package-name": "boundless",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(!@.source && (@.name.value == 'adapter-ipc-grpc' || @.name.value == 'app-services' || @.name.value == 'boundless-cli' || @.name.value == 'boundless-daemon' || @.name.value == 'boundless-input-injector' || @.name.value == 'boundless-tray' || @.name.value == 'control-plane-client' || @.name.value == 'core-clipboard' || @.name.value == 'core-discovery' || @.name.value == 'core-input' || @.name.value == 'core-protocol' || @.name.value == 'core-security' || @.name.value == 'core-transfer' || @.name.value == 'daemon-host' || @.name.value == 'ipc-api' || @.name.value == 'peer-transport' || @.name.value == 'platform-windows'))].version"
        },
        {
          "type": "toml",
          "path": "crates/adapter-ipc-grpc/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "crates/app-services/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
