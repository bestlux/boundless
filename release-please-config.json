          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "crates/input-injector/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "crates/ipc-api/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "crates/peer-transport/Cargo.toml",
