<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputName>Boundless</OutputName>
    <ProductVersion>0.0.0</ProductVersion>
    <PayloadDir>$(MSBuildThisFileDirectory)..\stage</PayloadDir>
    <DefineConstants>PayloadDir=$(PayloadDir);ProductVersion=$(ProductVersion)</DefineConstants>
    <!--
      ICE43/ICE57 expect non-advertised shortcuts to use an HKCU key path.
      This machine-wide skeleton intentionally creates common Start Menu/Desktop
      shortcuts with HKLM component key paths and no Startup shortcut.
      ICE61 rejects an upgrade range whose maximum equals the current version;
      that equality is intentional for private same-version dogfood rebuilds.
    -->
    <SuppressIces>ICE43;ICE57;ICE61;ICE64;ICE91</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="6.0.2" />
  </ItemGroup>
</Project>
