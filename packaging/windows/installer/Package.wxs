<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package
    Name="Boundless"
    Manufacturer="Boundless"
    Version="$(var.ProductVersion)"
    UpgradeCode="5A3406B6-73F7-4137-BF4D-4D4E4B75FC37"
    Language="1033"
    Scope="perMachine"
    InstallerVersion="500"
    Compressed="yes">

    <SummaryInformation Description="Boundless Installer" Manufacturer="Boundless" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Boundless is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="BoundlessIcon.ico" SourceFile="$(var.PayloadDir)\Boundless.ico" />
    <Property Id="ARPPRODUCTICON" Value="BoundlessIcon.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="BOUNDLESS_ALLOWED_USER_SID" Secure="yes" />
    <util:CloseApplication
      Id="CloseBoundlessTray"
      Target="boundlesstray.exe"
      Description="Boundless tray"
      RebootPrompt="no"
      TerminateProcess="1" />
    <util:CloseApplication
      Id="CloseBoundlessDaemon"
      Target="boundlessd.exe"
      Description="Boundless daemon"
      RebootPrompt="no"
      TerminateProcess="1" />
    <util:CloseApplication
      Id="CloseBoundlessService"
      Target="boundless-service.exe"
      Description="Boundless service"
      RebootPrompt="no"
      TerminateProcess="1" />

    <Property Id="BOUNDLESSLEGACYSCRIPTINSTALL">
      <DirectorySearch Id="LegacyScriptInstallDirSearch" Path="[LocalAppDataFolder]Programs\Boundless">
        <FileSearch Id="LegacyScriptInstallFileSearch" Name="Boundless-Install.ps1" />
      </DirectorySearch>
    </Property>

    <Launch
      Condition="Installed OR NOT BOUNDLESSLEGACYSCRIPTINSTALL"
      Message="A legacy script-installed Boundless build was detected in %LocalAppData%\Programs\Boundless. Uninstall the script-based package first, then rerun this installer." />
    <Launch
      Condition='REMOVE = "ALL" OR (BOUNDLESS_ALLOWED_USER_SID AND BOUNDLESS_ALLOWED_USER_SID &lt;&lt; "S-1-")'
      Message="BoundlessService requires an explicit numeric SID such as BOUNDLESS_ALLOWED_USER_SID=S-1-5-21-..." />
    <Launch
      Condition='REMOVE = "ALL" OR (NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "--") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&gt; "-"))'
      Message="BOUNDLESS_ALLOWED_USER_SID must not contain empty numeric segments." />
    <Launch
      Condition='REMOVE = "ALL" OR (NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; " ") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; ";") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "(") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; ")") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "["))'
      Message="BOUNDLESS_ALLOWED_USER_SID contains invalid SID characters." />
    <Launch
      Condition='REMOVE = "ALL" OR (NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "]") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; ".") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "_") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "/") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "\"))'
      Message="BOUNDLESS_ALLOWED_USER_SID contains invalid SID characters." />
    <Launch
      Condition='REMOVE = "ALL" OR (NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "A") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "B") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "C") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "D") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "E"))'
      Message="BOUNDLESS_ALLOWED_USER_SID must contain only S, digits, and dashes." />
    <Launch
      Condition='REMOVE = "ALL" OR (NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "F") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "G") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "H") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "I") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "J"))'
      Message="BOUNDLESS_ALLOWED_USER_SID must contain only S, digits, and dashes." />
    <Launch
      Condition='REMOVE = "ALL" OR (NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "K") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "L") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "M") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "N") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "O"))'
      Message="BOUNDLESS_ALLOWED_USER_SID must contain only S, digits, and dashes." />
    <Launch
      Condition='REMOVE = "ALL" OR (NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "P") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "Q") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "R") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "T") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "U"))'
      Message="BOUNDLESS_ALLOWED_USER_SID must contain only S, digits, and dashes." />
    <Launch
      Condition='REMOVE = "ALL" OR (NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "V") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "W") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "X") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "Y") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "Z"))'
      Message="BOUNDLESS_ALLOWED_USER_SID must contain only S, digits, and dashes." />
    <Launch
      Condition='REMOVE = "ALL" OR (NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "a") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "b") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "c") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "d") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "e"))'
      Message="BOUNDLESS_ALLOWED_USER_SID must contain only S, digits, and dashes." />
    <Launch
      Condition='REMOVE = "ALL" OR (NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "f") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "g") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "h") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "i") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "j"))'
      Message="BOUNDLESS_ALLOWED_USER_SID must contain only S, digits, and dashes." />
    <Launch
      Condition='REMOVE = "ALL" OR (NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "k") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "l") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "m") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "n") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "o"))'
      Message="BOUNDLESS_ALLOWED_USER_SID must contain only S, digits, and dashes." />
    <Launch
      Condition='REMOVE = "ALL" OR (NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "p") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "q") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "r") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "s") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "t"))'
      Message="BOUNDLESS_ALLOWED_USER_SID must contain only S, digits, and dashes." />
    <Launch
      Condition='REMOVE = "ALL" OR (NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "u") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "v") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "w"))'
      Message="BOUNDLESS_ALLOWED_USER_SID must contain only S, digits, and dashes." />
    <Launch
      Condition='REMOVE = "ALL" OR (NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "x") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "y") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "z"))'
      Message="BOUNDLESS_ALLOWED_USER_SID must contain only S, digits, and dashes." />
    <Launch
      Condition='REMOVE = "ALL" OR (NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "-S") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "-s") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "0S") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "1S"))'
      Message="BOUNDLESS_ALLOWED_USER_SID must contain only one leading S." />
    <Launch
      Condition='REMOVE = "ALL" OR (NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "2S") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "3S") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "4S") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "5S"))'
      Message="BOUNDLESS_ALLOWED_USER_SID must contain only one leading S." />
    <Launch
      Condition='REMOVE = "ALL" OR (NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "6S") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "7S") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "8S") AND NOT (BOUNDLESS_ALLOWED_USER_SID &gt;&lt; "9S"))'
      Message="BOUNDLESS_ALLOWED_USER_SID must contain only one leading S." />

    <Feature Id="MainFeature" Title="Boundless" Level="1">
      <ComponentGroupRef Id="BoundlessPayload" />
      <ComponentRef Id="BoundlessShortcuts" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLDIR" Name="Boundless" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />
  </Fragment>

  <Fragment>
    <ComponentGroup Id="BoundlessPayload" Directory="INSTALLDIR">
      <Component Id="BoundlessPayloadComponent" Guid="27CCE957-738A-450C-B2E4-3D4E86804FA0">
        <File Id="TrayBinaryFile" Source="$(var.PayloadDir)\boundlesstray.exe" />
        <File Id="DaemonBinaryFile" Source="$(var.PayloadDir)\boundlessd.exe" />
        <File Id="CliBinaryFile" Source="$(var.PayloadDir)\boundlessctl.exe" />
        <File Id="IconFile" Source="$(var.PayloadDir)\Boundless.ico" />
        <File Id="InstallHelperScriptFile" Source="$(var.PayloadDir)\Boundless-Install.ps1" />
        <File Id="ResetScriptFile" Source="$(var.PayloadDir)\Boundless-Reset.ps1" />
        <File Id="ConnectivityDiagnosticsScriptFile" Source="$(var.PayloadDir)\Boundless-ConnectivityDiagnostics.ps1" />
        <File Id="ReadmeFile" Source="$(var.PayloadDir)\README.txt" />
        <File Id="LicenseFile" Source="$(var.PayloadDir)\LICENSE.txt" />
        <File Id="ChangelogFile" Source="$(var.PayloadDir)\CHANGELOG.md" />
        <File Id="ManifestFile" Source="$(var.PayloadDir)\package-manifest.json" />
        <RegistryValue
          Root="HKLM"
          Key="Software\Boundless\Installer"
          Name="PayloadInstalled"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
      <ComponentRef Id="BoundlessStatusFixtureComponent" />
      <Component Id="BoundlessServicePayloadComponent" Guid="84E63D4D-84EE-485D-91CF-A5E04D07EC86">
        <File Id="ServiceBinaryFile" Source="$(var.PayloadDir)\boundless-service.exe" KeyPath="yes" />
        <ServiceInstall
          Id="BoundlessServiceInstall"
          Name="BoundlessService"
          DisplayName="Boundless Service"
          Description="Boundless service-mode daemon host."
          Type="ownProcess"
          Start="auto"
          ErrorControl="normal"
          Account="LocalSystem"
          Arguments="--allowed-user-sid=[BOUNDLESS_ALLOWED_USER_SID]" />
        <ServiceControl
          Id="BoundlessServiceControl"
          Name="BoundlessService"
          Start="install"
          Stop="both"
          Remove="uninstall"
          Wait="yes" />
        <RegistryValue
          Root="HKLM"
          Key="Software\Boundless\Installer"
          Name="ServicePayloadInstalled"
          Type="integer"
          Value="1"
          KeyPath="no" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Directory Id="BoundlessFixturesDirectory" Name="fixtures">
        <Component Id="BoundlessStatusFixtureComponent" Guid="AF6609AC-DAC6-42CC-B294-6AC0D46BA571">
          <File Id="DaemonStatusFixtureFile" Source="$(var.PayloadDir)\fixtures\daemon-status-single-line.txt" KeyPath="yes" />
        </Component>
      </Directory>
    </DirectoryRef>
  </Fragment>

  <Fragment>
    <Component Id="BoundlessShortcuts" Directory="INSTALLDIR" Guid="7604E036-DD43-4826-8E69-DAC44CDE295E">
      <Shortcut
        Id="StartMenuShortcut"
        Directory="ProgramMenuFolder"
        Name="Boundless"
        Description="Launch Boundless"
        Target="[INSTALLDIR]boundlesstray.exe"
        WorkingDirectory="INSTALLDIR"
        Icon="BoundlessIcon.ico"
        IconIndex="0" />
      <Shortcut
        Id="DesktopShortcut"
        Directory="DesktopFolder"
        Name="Boundless"
        Description="Launch Boundless"
        Target="[INSTALLDIR]boundlesstray.exe"
        WorkingDirectory="INSTALLDIR"
        Icon="BoundlessIcon.ico"
        IconIndex="0" />

      <RemoveFolder Id="RemoveInstallDirOnUninstall" Directory="INSTALLDIR" On="uninstall" />
      <RegistryValue
        Root="HKLM"
        Key="Software\Boundless\Installer"
        Name="Installed"
        Type="integer"
        Value="1"
        KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
